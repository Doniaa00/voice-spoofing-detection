# EditorConfig keeps whitespace/style consistent across editors and people.
# VS Code needs the "EditorConfig for VS Code" extension (see .vscode/extensions.json).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false  # trailing spaces can be meaningful in Markdown

[Makefile]
indent_style = tab
