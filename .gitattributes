# Normalize line endings: LF in the repo and in working copies (Windows + Colab).
* text=auto eol=lf

# Binary files: never touch line endings, never diff as text.
*.pdf  binary
*.docx binary
*.png  binary
*.wav  binary
*.npy  binary
*.pt   binary

# The run registry is hash-chained (D31): Git must never convert its line endings.
*.jsonl -text
